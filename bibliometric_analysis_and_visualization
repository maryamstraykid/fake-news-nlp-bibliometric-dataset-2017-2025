        "# Function to get full author names from Crossref using DOI\n",
        "def get_standardized_authors(doi):\n",
        "    try:\n",
        "        result = cr.works(ids=doi)\n",
        "        authors = result['message'].get('author', [])\n",
        "        return [f\"{a.get('given', '').strip()} {a.get('family', '').strip()}\" for a in authors]\n",
        "    except:\n",
        "        return []\n",
        "\n",
        "# OPTIONAL: Reduce rate limit issues by pausing between requests\n",
        "def get_authors_with_delay(doi):\n",
        "    time.sleep(1)  # 1-second delay between requests\n",
        "    return get_standardized_authors(doi)\n",
        "\n",
        "# Apply only on unique DOIs to avoid redundant requests\n",
        "doi_unique = data['DOI'].dropna().unique()\n",
